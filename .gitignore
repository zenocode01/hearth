# Windows 资源管理器配置文件
desktop.ini
Thumbs.db

# 依赖与构建产物
node_modules/
.next/
dist/
build/
out/
*.tsbuildinfo

# Next.js 自动生成
next-env.d.ts

# SQLite 数据（阶段 2 起）
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 用户上传的附件（消息里只存 /uploads 引用，文件本体不入库）
public/uploads/

# 日志与缓存
*.log
.cache/
.eslintcache

# 环境变量
.env
.env.local
.env.*.local

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store

# 参考源码（第三方仓库，不入库）
refs/

# 项目内隔离的 pi 运行时（**含 API key**，绝不入库）
